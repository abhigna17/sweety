DATABASE_URL="postgresql://sweety:sweety_dev_password@localhost:5432/sweety?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# AI privacy: personal health records are answered by the database engine and are never sent to hosted AI.
# Optional free hosted model for general product questions only (OpenRouter free models are rate-limited).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL="openrouter/free"
# Free local AI (no API key or per-message cost). Install Ollama and pull the model.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"
# Optional hosted alternative (may incur charges):
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL="gpt-4o-mini"
